    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@arayeshgar/core": "workspace:*",
    "@arayeshgar/db": "workspace:*",
    "@grammyjs/auto-retry": "^2.0.0",
    "drizzle-orm": "^0.45.0",
    "@hono/node-server": "^1.14.0",
    "grammy": "^1.40.0",
    "hono": "^4.10.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@arayeshgar/config": "workspace:*",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
