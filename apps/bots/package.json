{
  "name": "@arayeshgar/bots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One process, N bots: Telegram + Bale webhooks per tenant, notification outbox worker, scheduled jobs.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
