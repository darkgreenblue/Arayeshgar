# ---------- Core ----------
NODE_ENV=development
# Base domain for tenant subdomains. Tenants live at <slug>.<BASE_DOMAIN>; platform panel at platform.<BASE_DOMAIN>
BASE_DOMAIN=localhost
# Public URL scheme+host used in links sent to customers (bots, notifications)
PUBLIC_URL_SCHEME=http
# مسیر فایل SQLite. خالی بگذارید تا همین پیش‌فرض استفاده شود.
DATABASE_URL=data/arayeshgar.db
# 32+ random chars; signs admin/customer session cookies
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where uploaded receipts/photos are stored (disk adapter)
UPLOADS_DIR=./data/uploads
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info

# ---------- Bots (per-tenant tokens live in the DB; these are global) ----------
# Telegram Bot API root. Keep default on a foreign VPS. From inside Iran point it at a relay.
TELEGRAM_API_ROOT=https://api.telegram.org
BALE_API_ROOT=https://tapi.bale.ai
# Public base URL that Telegram/Bale will POST webhooks to (must be HTTPS in production)
BOTS_PUBLIC_URL=http://localhost:3001
BOTS_PORT=3001
# polling | webhook. polling هیچ آدرس عمومی لازم ندارد، پس دمو روی لپ‌تاپ هم کار می‌کند.
# webhook فقط وقتی که یک آدرس HTTPS پایدار داشته باشیم.
BOT_TRANSPORT=polling
# Worker loop interval in seconds (expire unpaid bookings, drain outbox, enqueue reminders)
WORKER_INTERVAL_SEC=30

# ---------- Optional modules ----------
# AI copywriting in onboarding (module ai_copy). Leave empty to use static templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Platform owner bootstrap (first run only) ----------
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-me
