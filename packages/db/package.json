{
  "name": "@arayeshgar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, seed and tenant-scoped DB client.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed-cli.ts",
    "test": "echo 'no tests in @arayeshgar/db'"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@arayeshgar/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
