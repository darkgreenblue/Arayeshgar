# Routes:
#   platform.<BASE_DOMAIN>      -> web (platform panel)
#   *.<BASE_DOMAIN>             -> web (tenant sites, resolved by hostname inside Next.js)
#   bots.<BASE_DOMAIN>          -> bots (Telegram/Bale webhooks)
#   any other host              -> web, TLS issued on demand ONLY if /api/caddy/ask approves it
{
  email {$ACME_EMAIL}
  on_demand_tls {
    ask http://web:3000/api/caddy/ask
  }
}

# Local development: BASE_DOMAIN=localhost => internal CA, no ACME.
(common) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

bots.{$BASE_DOMAIN} {
  import common
  reverse_proxy bots:3001
}

{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
  import common
  # Wildcard TLS requires DNS challenge (caddy-dns plugin). Until configured, Caddy issues a
  # per-subdomain certificate via HTTP-01 the first time each subdomain is visited, which works
  # for demos. For localhost Caddy uses its internal CA automatically.
  tls {
    on_demand
  }
  reverse_proxy web:3000
}

# Customer-owned custom domains (CNAME -> this server). Approved by the ask endpoint.
https:// {
  import common
  tls {
    on_demand
  }
  reverse_proxy web:3000
}
